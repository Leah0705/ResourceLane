KAFKA_CONTAINER=kafka
BOOTSTRAP_SERVER=localhost:9092
# BOOTSTRAP_SERVER=kafka:9092
# name[:partitions]. order, trade, ltp and orderbook carry one book under one key, so a
# single partition keeps them in the order the producer wrote them. status is keyed by order ID.
TOPICS="order trade ltp orderbook status:3 trade.DLT status.DLT"
REPLICATION_FACTOR=1
PARTITIONS=1
ZOOKEEPER_CONTAINER=zookeeper
